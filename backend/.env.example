# Copy this file to .env for local development and fill in your own values. Never commit the real
# .env: the repo's root .gitignore covers `.env` and `.env.*`, except this .env.example.
#
# In production (Railway) there is no .env file: set these same names as service variables.
# Secrets are read only from the environment; none is ever written in the code.

# REQUIRED for real OpenAI-backed analysis. Leave it unset to run in local-only mode: every AI route
# then answers { status: "not_configured" } and the extension falls back to its own analysis.
OPENAI_API_KEY=

# Optional. The model used for every AI call. Defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna

# Optional. The port to listen on. Railway sets PORT itself, so leave it out there; locally it
# defaults to 8787, which is what the extension's development build expects.
PORT=8787

# Optional. The address to bind. Defaults to 0.0.0.0 (all interfaces), which a cloud host needs.
# HOST=0.0.0.0

# Not used today: this backend has no database, so there is no Supabase (or other) secret to set.
