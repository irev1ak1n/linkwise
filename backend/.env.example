# Copy this file to .env and fill in your own values. Never commit the real .env — it's
# already covered by the repo's root .gitignore (`.env`, `.env.*`, with an explicit exception
# for this .env.example file).

# Required for real OpenAI-backed analysis. Leave unset (or delete the line) to run the backend
# in local-only mode — POST /api/analyze-profile will respond with { status: "not_configured" }
# and the extension falls back to its own deterministic analysis automatically.
OPENAI_API_KEY=

# Model used for the structured criterion-analysis call. Configurable specifically so this can
# be swapped later (e.g. for a stronger competition model) without touching any code — see
# backend/src/openai/client.ts, the only place this value is read.
OPENAI_MODEL=gpt-5.6-luna

# Port the backend listens on. The extension's default API base URL (see src/ai/config.ts)
# assumes this same default — change both together if you use a different port.
PORT=8787
