# Build-time settings for the Chrome extension (read from the environment when running `npm run build`;
# no file is loaded, and nothing here is a secret).
#
# Where the extension finds the backend. Unset = the local backend, http://localhost:8787 (development).
# For a production build, set it to the deployed backend's https origin, with no path:
#   PowerShell:  $env:LINKWISE_API_BASE_URL = "https://your-app.up.railway.app"; npm run build
#   Git Bash:    LINKWISE_API_BASE_URL=https://your-app.up.railway.app npm run build
# The build also adds that origin to the extension's host permissions in dist/manifest.json.
# LINKWISE_API_BASE_URL=https://your-app.up.railway.app

# The backend's own settings (OpenAI key and so on) are in backend/.env.example.
